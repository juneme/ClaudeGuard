<Window x:Class="ClaudeGuard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="ClaudeGuard" Width="1040" Height="740" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F9F9F7" Icon="Assets/ClaudeGuard.ico" MouseLeftButtonDown="DragTitle">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#8B8B8D"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="WindowControl" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LaunchAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#DDE9D9"/><Setter Property="Foreground" Value="#2F5136"/><Setter Property="BorderBrush" Value="#C4D6BE"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D0E0CA"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#E7EAE5"/><Setter TargetName="Surface" Property="BorderBrush" Value="#D7DDD5"/><Setter Property="Foreground" Value="#68766A"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavItem" TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="13,11"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6E9E2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WarnAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#F6E7D6"/><Setter Property="Foreground" Value="#7A4A12"/><Setter Property="BorderBrush" Value="#E8D3BA"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EFDAC2"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CountryOption" TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="#35463A"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#E8EEE6"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CountryScrollBar" TargetType="ScrollBar">
   <Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Margin="1,4"><Track x:Name="PART_Track" IsDirectionReversed="True">
    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Background="#BACABB" MinHeight="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
   </Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CountrySelect" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D9E0D8"/><Setter Property="Foreground" Value="#35463A"/><Setter Property="ItemContainerStyle" Value="{StaticResource CountryOption}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Box" CornerRadius="8" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1"><Grid><Path Width="8" Height="5" HorizontalAlignment="Right" Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0" Stroke="#637568" StrokeThickness="1.4"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#F4F7F2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Margin="12,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#FFFFFF" BorderBrush="#D9E0D8" BorderThickness="1" CornerRadius="8" Padding="4"><ScrollViewer MaxHeight="240" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource CountryScrollBar}"/></ScrollViewer.Resources><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Toggle" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="#D7D7D4" BorderThickness="1" CornerRadius="12">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F0F0ED" CornerRadius="12,0,0,12" BorderBrush="#E1E1DD" BorderThickness="0,0,1,0">
   <Grid Margin="22,22,18,22">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
     <Button x:Name="CloseButton" Style="{StaticResource WindowControl}" Content="×" Foreground="#6E231F" Background="#ED6A5E" BorderBrush="#DE5D50" Click="CloseClick" ToolTip="关闭窗口（隐藏到托盘）" AutomationProperties.Name="关闭窗口（隐藏到托盘）"/>
     <Button x:Name="MinimizeButton" Style="{StaticResource WindowControl}" Content="−" Foreground="#70520C" Margin="9,0,0,0" Background="#F4BF4F" BorderBrush="#DBAC43" Click="MinimizeClick" ToolTip="最小化" AutomationProperties.Name="最小化"/>
     <Button x:Name="MaximizeButton" Style="{StaticResource WindowControl}" Content="□" FontSize="10" Foreground="#225C20" Margin="9,0,0,0" Background="#62C554" BorderBrush="#53AD47" Click="MaximizeClick" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原"/>
    </StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="◈" FontSize="27" Foreground="#516D60"/><TextBlock Text="ClaudeGuard" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,22,0,0">
     <TextBlock Text="工作空间" Style="{StaticResource Muted}" Margin="9,0,0,12"/>
     <Grid><Border x:Name="OverviewBg" Background="#DFE4DE" CornerRadius="8"/><Button x:Name="OverviewNav" Style="{StaticResource NavItem}" Click="ShowOverview" AutomationProperties.Name="连接概览">
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="OverviewDot" Text="◉" FontSize="12" Foreground="#3F5C49" VerticalAlignment="Center"/><TextBlock x:Name="OverviewText" Text="连接概览" Foreground="#3F5C49" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0"/></StackPanel>
     </Button></Grid>
     <Grid Margin="0,4,0,0"><Border x:Name="RiskBg" Background="Transparent" CornerRadius="8"/><Button x:Name="RiskNav" Style="{StaticResource NavItem}" Click="ShowRisk" AutomationProperties.Name="出口与风险">
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="RiskDot" Text="○" FontSize="12" Foreground="#8A8F86" VerticalAlignment="Center"/><TextBlock x:Name="RiskText" Text="出口与风险" Foreground="#6F746C" FontSize="13" Margin="10,0,0,0"/></StackPanel>
     </Button></Grid>
     <TextBlock x:Name="NavHint" Text="检测 · 修复 · 启动" Foreground="#999B96" FontSize="11" Margin="13,12,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="4">
     <Border Background="#E7E9E3" CornerRadius="9" Padding="12"><StackPanel><TextBlock x:Name="ServiceLabel" Text="●  正在启动守护" FontSize="12" Foreground="#657064"/><TextBlock Text="托盘退出后停止守护" FontSize="10" Foreground="#92968E" Margin="13,6,0,0"/></StackPanel></Border>
    <TextBlock x:Name="VersionLabel" Text="WINDOWS" FontSize="10" Foreground="#AAACA5" Margin="9,18,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="OverviewPage" Grid.Column="1" Margin="38,0,38,24">
   <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Background="Transparent"><TextBlock Text="连接概览" FontSize="13" Foreground="#777974" VerticalAlignment="Center"/><TextBlock Text="CLARITY, BEFORE YOU CONNECT." FontSize="9" Foreground="#A1A49C" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <StackPanel Grid.Row="1">
    <TextBlock Text="连接，从容一点。" FontSize="29" FontWeight="SemiBold"/>
    <TextBlock Text="先确认代理与出口，再把持续守护交给后台。" FontSize="13" Foreground="#969891" Margin="0,10,0,23"/>
   </StackPanel>
   <Border x:Name="StatusCard" Grid.Row="2" Background="#EDF1EA" CornerRadius="13" Padding="23,21" BorderBrush="#E1E7DC" BorderThickness="1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="StatusBadge" Width="39" Height="39" Background="#DCE6D6" CornerRadius="12" VerticalAlignment="Top"><TextBlock x:Name="StatusSymbol" Text="◈" FontSize="23" Foreground="#5A7654" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1"><TextBlock x:Name="StatusTitle" Text="准备好，再出发" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Text="点击「开始检测」，确认代理、出口与连接保护。" Foreground="#808B79" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="LastChecked" Text="尚未检测" FontSize="10" Foreground="#929C8C" Margin="0,12,0,0"/><Button x:Name="ServiceSetupButton" Content="重试启动守护" Click="RetryService" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0"/></StackPanel>
    </Grid>
   </Border>
   <StackPanel Grid.Row="3" Margin="0,22,0,0">
    <Grid Margin="0,0,0,13"><TextBlock Text="连接检查" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="目标地区" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="CountryBox" Style="{StaticResource CountrySelect}" Width="90" SelectionChanged="InputsChanged"/></StackPanel></Grid>
    <ItemsControl x:Name="ChecksList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EAEAE6" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" FontSize="14" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#979991" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
   <StackPanel Grid.Row="4">
    <Expander x:Name="SettingsPanel" Header="客户端与服务设置" Foreground="#878A82" FontSize="11" Margin="0,12,0,16"><StackPanel Margin="0,12,0,0">
     <TextBlock Text="Claude 安装位置（自动查找，可手动指定）" Style="{StaticResource Muted}" Margin="0,0,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ClaudePath" FontSize="11" VerticalContentAlignment="Center" Padding="8,6" TextChanged="ClaudePathChanged" ToolTip="自动查找官方 Claude 安装位置，也可手动指定 Claude.exe"/><Button x:Name="BrowseClaudeButton" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="12,6" Click="BrowseClaude" ToolTip="手动选择已安装的 Claude.exe"/></Grid>
     <TextBlock Text="Clash 控制接口密钥（通常自动读取）" Style="{StaticResource Muted}" Margin="0,8,0,5"/><PasswordBox x:Name="ControllerSecret" PasswordChanged="SecretChanged" Padding="8,6" ToolTip="仅用于本机通信，不写日志。"/>
    </StackPanel></Expander>
    <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="CheckButton" Content="开始检测" Click="CheckClick"/><Button x:Name="RepairButton" Content="修复连接" Margin="9,0,0,0" Click="RepairClick"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock x:Name="LaunchHint" Text="检测通过后可启动" FontSize="10" Foreground="#728074" HorizontalAlignment="Right" Margin="0,0,2,6"/><Button x:Name="LaunchButton" Style="{StaticResource LaunchAction}" Content="启动 Claude  ↗" HorizontalAlignment="Right" IsEnabled="False" Click="LaunchClick" Padding="26,11" ToolTipService.ShowOnDisabled="True" ToolTip="先完成连接检查并修复未通过的项目"/></StackPanel></Grid>
    <TextBlock Text="出口检测不代表实际所在地合规。请遵守 Claude 的地区政策。" Foreground="#ADAEA7" FontSize="10" Margin="0,16,0,0"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="RiskPage" Grid.Column="1" Margin="38,0,38,24" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Background="Transparent"><TextBlock Text="出口与风险" FontSize="13" Foreground="#777974" VerticalAlignment="Center"/><TextBlock Text="EVIDENCE, NOT OPINION." FontSize="9" Foreground="#A1A49C" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <StackPanel Grid.Row="1">
    <TextBlock Text="出口，看清一点。" FontSize="29" FontWeight="SemiBold"/>
    <TextBlock Text="Claude 侧看到的地址与属性，逐项和目标地区比对后再决定是否启动。" FontSize="13" Foreground="#969891" Margin="0,10,0,23"/>
   </StackPanel>
   <Border x:Name="RiskCard" Grid.Row="2" Background="#EDF1EA" CornerRadius="13" Padding="23,21" BorderBrush="#E1E7DC" BorderThickness="1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border x:Name="RiskBadge" Width="39" Height="39" Background="#DCE6D6" CornerRadius="12" VerticalAlignment="Top"><TextBlock x:Name="RiskSymbol" Text="◈" FontSize="21" Foreground="#5A7654" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock x:Name="RiskTitle" Text="尚未检测" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="RiskDetail" Text="完成一次检测后，这里会显示 Claude 侧出口的信任分与属性判定。" Foreground="#808B79" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Column="2" Width="196" VerticalAlignment="Top" HorizontalAlignment="Right">
      <TextBlock Text="CLAUDE 侧出口" FontSize="9" Foreground="#A1A49C" HorizontalAlignment="Right"/>
      <TextBlock x:Name="RiskIp" Text="—" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="RiskGeo" Text="—" FontSize="11" Foreground="#8B8B8D" HorizontalAlignment="Right" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Grid>
   </Border>
   <StackPanel Grid.Row="3" Margin="0,20,0,0">
    <Grid Margin="0,0,0,4"><TextBlock Text="逐项对比" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="RiskTarget" Text="目标地区 —" FontSize="11" Foreground="#8B8B8D" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Margin="0,10,0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
     <TextBlock Text="检测项" FontSize="10" Foreground="#A1A49C"/>
     <TextBlock Grid.Column="1" Text="实际结果" FontSize="10" Foreground="#A1A49C"/>
     <TextBlock Grid.Column="2" Text="期望" FontSize="10" Foreground="#A1A49C"/>
     <TextBlock Grid.Column="3" Text="判定" FontSize="10" Foreground="#A1A49C" HorizontalAlignment="Right"/>
    </Grid>
    <ItemsControl x:Name="RiskRows"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EAEAE6" BorderThickness="0,0,0,1" Padding="0,9"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="{Binding Actual}" FontSize="12" Foreground="#55584F" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
     <TextBlock Grid.Column="2" Text="{Binding Expected}" FontSize="11" Foreground="#979991" VerticalAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock Grid.Column="3" Text="{Binding Verdict}" Foreground="{Binding Color}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
   <Grid Grid.Row="4" Margin="0,14,0,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="RiskCheckButton" Content="重新检测" Click="CheckClick"/><Button x:Name="ForceButton" Style="{StaticResource WarnAction}" Content="仍然强制启动  ↗" Margin="9,0,0,0" Padding="18,7" Click="ForceClick" Visibility="Collapsed"/></StackPanel>
    <TextBlock x:Name="RiskNote" Text="风险数据来自 claude.ai 与 ip.net.coffee，仅用于判断出口。" FontSize="10" Foreground="#ADAEA7" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="320" TextWrapping="Wrap" TextAlignment="Right"/>
   </Grid>
  </Grid>
 </Grid>
 </Border>
</Window>
